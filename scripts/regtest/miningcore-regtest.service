[Unit]
Description=Miningcore LTC-DOGE merged-mining regtest
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=miningcore
Group=miningcore
WorkingDirectory=/opt/miningcore
ExecStart=/usr/bin/dotnet /opt/miningcore/Miningcore.dll -c /etc/miningcore/config.json
Restart=on-failure
RestartSec=5
# .NET's systemd/console lifetime handles SIGTERM. Do not override this with
# SIGINT for a non-interactive service or graceful host shutdown may not start.
KillSignal=SIGTERM
# Miningcore's internal graceful-stop budget is 45 seconds. Keep a service-manager
# margin so manager quiescence and a forced recovery-journal flush can finish first.
TimeoutStopSec=60
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=LD_LIBRARY_PATH=/opt/miningcore
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
