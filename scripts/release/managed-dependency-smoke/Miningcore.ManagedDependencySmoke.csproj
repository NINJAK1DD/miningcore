<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Miningcore.ManagedDependencySmoke</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MiningcorePublishDir Condition="'$(MiningcorePublishDir)' == ''">$(MSBuildThisFileDirectory)../../../publish</MiningcorePublishDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="NBitcoin">
      <HintPath>$(MiningcorePublishDir)/NBitcoin.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NBitcoin.Zcash">
      <HintPath>$(MiningcorePublishDir)/NBitcoin.Zcash.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
