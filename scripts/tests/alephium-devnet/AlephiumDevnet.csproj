<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <MiningcoreOutput Condition="'$(MiningcoreOutput)' == ''">$(MSBuildThisFileDirectory)../../../src/Miningcore/bin/Debug/net10.0</MiningcoreOutput>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(MiningcoreOutput)/*.dll" />
  </ItemGroup>
</Project>
