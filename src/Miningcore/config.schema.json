    "PoolConfig": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "banning": {
          "$ref": "#/definitions/PoolShareBasedBanningConfig"
        },
