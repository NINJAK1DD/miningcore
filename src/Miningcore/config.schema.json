        "port": {
          "type": "integer"
        },
        "sslMode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "Disable",
            "Allow",
            "Prefer",
            "Require",
            "VerifyCA",
            "VerifyFull"
          ]
        },
        "tls": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tlsCert": {
          "type": [
            "string",
            "null"
          ]
        },
        "tlsKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "tlsNoValidate": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tlsPassword": {
          "type": [
            "string",
            "null"
          ]
        },
        "tlsRootCert": {
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "not": {
            "type": "object",
            "required": [
              "sslMode",
              "tls"
            ],
            "properties": {
              "sslMode": {
                "type": "string"
              },
              "tls": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "not": {
            "type": "object",
            "required": [
              "sslMode",
              "tlsNoValidate"
            ],
            "properties": {
              "sslMode": {
                "type": "string"
              },
              "tlsNoValidate": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "not": {
            "type": "object",
            "required": [
              "tlsRootCert"
            ],
            "properties": {
              "tlsRootCert": {
                "type": "string"
              }
            },
            "not": {
              "required": [
                "sslMode"
              ],
              "properties": {
                "sslMode": {
                  "enum": [
                    "VerifyCA",
                    "VerifyFull"
                  ]
                }
              }
            }
          }
        }
      ]
    },
