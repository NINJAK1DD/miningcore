          "type": "integer"
        },
        "clientConnectionTimeout": {
          "type": "integer"
        },
        "coin": {
          "type": "string"
        },
        "connectionAdmission": {
          "$ref": "#/definitions/StratumAdmissionConfig"
        },
        "daemons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DaemonEndpointConfig"
          }
        },
        "enableAsicBoost": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "enableInternalStratum": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "jobRebroadcastTimeout": {
          "type": "integer"
        },
        "paymentProcessing": {
          "$ref": "#/definitions/PoolPaymentProcessingConfig"
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/PoolEndpoint"
          }
        },
        "pubKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "rewardRecipients": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/RewardRecipient"
          }
        },
        "vardiffIdleSweepInterval": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "coin",
        "daemons",
        "id",
        "ports"
      ],
      "allOf": [
        {
          "anyOf": [
            {
              "not": {
                "properties": {
                  "coin": {
                    "enum": [
                      "pearl"
                    ]
                  }
                },
                "required": [
                  "coin"
                ]
              }
            },
            {
              "required": [
                "proofWorker"
              ],
              "properties": {
                "network": {
                  "type": "string",
                  "enum": [
                    "mainnet",
                    "regtest"
                  ],
                  "default": "mainnet"
                },
                "proofWorker": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Absolute path to the pinned Linux x64 Pearl proof worker."
                },
                "templatePollSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30,
                  "default": 5
                },
                "jobLifetimeSeconds": {
                  "type": "integer",
                  "minimum": 30,
                  "maximum": 180,
                  "default": 120
                },
                "maximumJobsPerWorker": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 16,
                  "default": 8
                },
                "maximumConnections": {
                  "type": "integer",
                  "minimum": 16,
                  "maximum": 4096,
                  "default": 1024
                },
                "maximumProofFrames": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096,
                  "default": 256
                },
                "maximumProofBufferMiB": {
                  "type": "integer",
                  "minimum": 64,
                  "maximum": 1024,
                  "default": 256
                },
                "maximumProofFramesPerIp": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "default": 4
                },
                "paymentProcessing": {
                  "properties": {
                    "minimumPayment": {
                      "type": "number",
                      "minimum": 0.01
                    },
                    "feeRateGrainsPerKb": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 100000000,
                      "default": 10000
                    },
                    "minimumConfirmations": {
                      "type": "integer",
                      "minimum": 101,
                      "maximum": 100000,
                      "default": 101
                    },
                    "payoutScheme": {
                      "enum": [
                        "PPS",
                        "SOLO",
                        "PPLNS",
                        "PROP"
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
