<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Miningcore</AssemblyName>
        <RootNamespace>Miningcore</RootNamespace>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>true</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <IsWindows Condition="'$(OS)' == 'Windows_NT'">true</IsWindows>
        <IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux>
        <IsOSX Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</IsOSX>
        <BuildOdoCryptWindows Condition="'$(BuildOdoCryptWindows)' == ''">true</BuildOdoCryptWindows>
        <OdoCryptWindowsRuntime Condition="'$(IsWindows)' == 'true'">$(ProjectDir)..\Native\libodocrypt\bin\x64\Release\libodocrypt.dll</OdoCryptWindowsRuntime>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsWindows)' == 'true'">
        <OdoCryptWindowsBuildInputs Include="$(MSBuildProjectFullPath)" />
        <OdoCryptWindowsBuildInputs Include="$(ProjectDir)..\..\scripts\release\build-windows-odocrypt.ps1" />
        <OdoCryptWindowsBuildInputs Include="$(ProjectDir)..\Native\libodocrypt\libodocrypt.vcxproj" />
        <OdoCryptWindowsBuildInputs Include="$(ProjectDir)..\Native\libodocrypt\exports.cpp" />
        <OdoCryptWindowsBuildInputs Include="$(ProjectDir)..\Native\libodocrypt\upstream.sha256" />
        <OdoCryptWindowsBuildInputs Include="$(ProjectDir)..\Native\libmultihash\odocrypt.cpp" />
        <OdoCryptWindowsBuildInputs Include="$(ProjectDir)..\Native\libmultihash\odocrypt.h" />
        <OdoCryptWindowsBuildInputs Include="$(ProjectDir)..\Native\libmultihash\KeccakP-800-reference.c" />
        <OdoCryptWindowsBuildInputs Include="$(ProjectDir)..\Native\libmultihash\KeccakP-800-SnP.h" />
        <OdoCryptWindowsBuildInputs Include="$(ProjectDir)..\Native\libmultihash\brg_endian.h" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>$(AssemblyName).Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                           Condition="'$(MiningcoreReleaseVersion)' != ''">
            <_Parameter1>MiningcoreReleaseVersion</_Parameter1>
            <_Parameter2>$(MiningcoreReleaseVersion)</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                           Condition="'$(MiningcoreSourceCommit)' != ''">
            <_Parameter1>MiningcoreSourceCommit</_Parameter1>
            <_Parameter2>$(MiningcoreSourceCommit)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Api\Notifications\**" />
        <Compile Remove="Blockchain\Bitcoin\Transactions\**" />
        <Compile Remove="DataAccess\**" />
        <Compile Remove="Maintenance\**" />
        <EmbeddedResource Remove="Api\Notifications\**" />
        <EmbeddedResource Remove="Blockchain\Bitcoin\Transactions\**" />
        <EmbeddedResource Remove="DataAccess\**" />
        <EmbeddedResource Remove="Maintenance\**" />
        <None Remove="Api\Notifications\**" />
        <None Remove="Blockchain\Bitcoin\Transactions\**" />
        <None Remove="DataAccess\**" />
        <None Remove="Maintenance\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="config2.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
        <PackageReference Include="Autofac" Version="8.2.0" />
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="CircularBuffer" Version="1.4.0" />
        <PackageReference Include="blake3" Version="0.5.1" />
        <PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
        <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.0" />
        <PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.1" />
        <PackageReference Include="Npgsql" Version="9.0.3" />
        <PackageReference Include="NSwag.AspNetCore" Version="14.7.1" />
        <PackageReference Include="NSwag.CodeGeneration.CSharp" Version="14.7.1" />
        <PackageReference Include="NSwag.MSBuild" Version="14.7.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NLog.Extensions.Hosting" Version="5.3.8" />
        <PackageReference Include="AutoMapper" Version="16.2.0" />
        <PackageReference Include="Dapper" Version="2.1.35" />
        <PackageReference Include="FluentValidation" Version="11.11.0" />
        <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
        <PackageReference Include="JetBrains.Annotations" Version="2024.3.0" />
        <PackageReference Include="MailKit" Version="4.17.0" />
        <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="4.0.2" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
        <PackageReference Include="NBitcoin" Version="7.0.42" />
        <PackageReference Include="NBitcoin.Altcoins" Version="3.0.28" />
        <PackageReference Include="NBitcoin.Zcash" Version="3.0.0" />
        <PackageReference Include="NBitcoin.Secp256k1" Version="3.1.6" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="NLog" Version="5.4.0" />
        <PackageReference Include="NLog.Extensions.Logging" Version="5.4.0" />
        <PackageReference Include="Polly" Version="8.3.1" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
        <!-- NBitcoin.Zcash still requires the legacy BouncyCastle.Crypto assembly at runtime. Restricting
             this reference to runtime assets avoids compiling Miningcore against the legacy
             assembly while keeping it in published application dependency manifests. -->
        <PackageReference Include="Portable.BouncyCastle" Version="1.9.0">
            <IncludeAssets>runtime</IncludeAssets>
        </PackageReference>
        <PackageReference Include="prometheus-net.AspNetCore" Version="8.1.0" />
        <PackageReference Include="prometheus-net" Version="8.2.0" />
        <PackageReference Include="protobuf-net" Version="3.2.30" />
        <PackageReference Include="System.Reactive" Version="6.0.0" />
        <PackageReference Include="Grpc.AspNetCore" Version="2.66.0" />
        <PackageReference Include="Google.Protobuf" Version="3.36.1" />
        <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
        <PackageReference Include="Grpc.Tools" Version="2.66.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="WebSocketManager">
            <HintPath>..\..\libs\WebSocketManager.dll</HintPath>
        </Reference>
        <Reference Include="WebSocketManager.Common">
            <HintPath>..\..\libs\WebSocketManager.Common.dll</HintPath>
        </Reference>
        <Reference Include="ZeroMQ">
            <HintPath>..\..\libs\ZeroMQ.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Update="coins.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Reference legacy pre-built library binaries on Windows. Odocrypt is deliberately absent
         from this directory and is built from its reviewed, pinned sources below. -->
    <ItemGroup Condition="'$(IsWindows)' == 'true'">
        <NativeLibs Include="$(ProjectDir)..\..\libs\runtimes\win-x64\*.dll"
                    Exclude="$(ProjectDir)..\..\libs\runtimes\win-x64\libodocrypt.dll" />
        <None Include="@(NativeLibs)" Visible="False">
            <Link>%(RecursiveDir)%(FileName)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="$(OdoCryptWindowsRuntime)" Visible="False"
              Condition="'$(BuildOdoCryptWindows)' == 'true'">
            <Link>libodocrypt.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
      <None Remove="schema.json" />
      <Content Include="config.schema.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <!-- Build library binaries from source on Linux. The narrowly scoped listener-portability
         smoke compiles only the managed Stratum socket path and deliberately skips unrelated
         hashing libraries so it can run quickly on musl. Do not set that property for a
         runnable Miningcore build or publish. -->
    <Target Name="BuildNativeLibsLinux" AfterTargets="AfterBuild"
            Condition="'$(IsLinux)' == 'true' and '$(MiningcoreStratumListenerSmoke)' != 'true'">
        <!-- Invoke Bash explicitly: this driver uses strict Bash semantics and must not be
             downgraded to /bin/sh by an outer build shell. -->
        <Exec Command="(cd $(ProjectDir) &amp;&amp; bash build-libs-linux.sh $(OutDir))" />
    </Target>

    <!-- Fail closed before every ordinary Windows build or publish: verify the immutable native
         inputs and compile Odocrypt locally instead of trusting an opaque checked-in DLL. -->
    <Target Name="GuardOdoCryptWindows" BeforeTargets="PrepareForBuild"
            Condition="'$(IsWindows)' == 'true' and '$(DesignTimeBuild)' != 'true'">
        <Error Condition="'$(BuildOdoCryptWindows)' != 'true' and '$(BuildOdoCryptWindows)' != 'false'"
               Text="BuildOdoCryptWindows must be true or false." />
        <Error Condition="Exists('$(ProjectDir)..\..\libs\runtimes\win-x64\libodocrypt.dll')"
               Text="Remove the opaque checked-in libs\runtimes\win-x64\libodocrypt.dll; Windows Odocrypt must be built from reviewed source." />
    </Target>

    <Target Name="RemoveOdoCryptFromManagedOnlyOutput" BeforeTargets="PrepareForBuild"
            Condition="'$(IsWindows)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildOdoCryptWindows)' == 'false'">
        <Delete Files="$(TargetDir)libodocrypt.dll" />
    </Target>

    <Target Name="CompileOdoCryptWindows" BeforeTargets="PrepareForBuild"
            DependsOnTargets="GuardOdoCryptWindows"
            Inputs="@(OdoCryptWindowsBuildInputs)" Outputs="$(OdoCryptWindowsRuntime)"
            Condition="'$(IsWindows)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildOdoCryptWindows)' == 'true' and '$(MININGCORE_WINDOWS_PLATFORM_TOOLSET)' == ''">
        <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\..\scripts\release\build-windows-odocrypt.ps1&quot;" />
        <Error Condition="!Exists('$(OdoCryptWindowsRuntime)')"
               Text="The reviewed Windows Odocrypt build did not produce $(OdoCryptWindowsRuntime)." />
        <!-- Native MSBuild can report an up-to-date project without updating the DLL timestamp.
             Mark the verified output current so this outer target can remain incremental. -->
        <Touch Files="$(OdoCryptWindowsRuntime)" />
    </Target>

    <!-- A compatibility-toolset override is an input that cannot be represented by a source-file
         timestamp. Rebuild unconditionally so changing it always reaches native MSBuild. -->
    <Target Name="CompileOdoCryptWindowsWithToolsetOverride" BeforeTargets="PrepareForBuild"
            DependsOnTargets="GuardOdoCryptWindows"
            Condition="'$(IsWindows)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildOdoCryptWindows)' == 'true' and '$(MININGCORE_WINDOWS_PLATFORM_TOOLSET)' != ''">
        <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\..\scripts\release\build-windows-odocrypt.ps1&quot;" />
        <Error Condition="!Exists('$(OdoCryptWindowsRuntime)')"
               Text="The reviewed Windows Odocrypt build did not produce $(OdoCryptWindowsRuntime)." />
    </Target>

    <!-- Include legacy binaries plus the source-built Odocrypt runtime in Windows publishes. -->
    <Target Name="NativeLibsPublishIncludeWin" BeforeTargets="PrepareForPublish"
            DependsOnTargets="GuardOdoCryptWindows;CompileOdoCryptWindows;CompileOdoCryptWindowsWithToolsetOverride" Condition="'$(IsWindows)' == 'true'">
        <Error Condition="'$(BuildOdoCryptWindows)' != 'true'"
               Text="Windows publish requires BuildOdoCryptWindows=true so Odocrypt is compiled from reviewed source." />
        <ItemGroup>
            <Libs Include="$(ProjectDir)..\..\libs\runtimes\win-x64\*.dll"
                  Exclude="$(ProjectDir)..\..\libs\runtimes\win-x64\libodocrypt.dll" />
            <ContentWithTargetPath Include="@(Libs->'%(FullPath)')" RelativePath="%(Libs.Identity)" TargetPath="%(Libs.Filename)%(Libs.Extension)" CopyToPublishDirectory="PreserveNewest" />
            <ContentWithTargetPath Include="$(OdoCryptWindowsRuntime)" RelativePath="$(OdoCryptWindowsRuntime)" TargetPath="libodocrypt.dll" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <!-- Include library binaries in publish on Linux -->
    <Target Name="NativeLibsPublishIncludeLinux" BeforeTargets="PrepareForPublish" Condition="'$(IsLinux)' == 'true'">
        <Error Condition="'$(MiningcoreStratumListenerSmoke)' == 'true'"
               Text="MiningcoreStratumListenerSmoke is a test-only managed build mode and cannot be used to publish Miningcore." />
        <ItemGroup>
            <Libs Include="$(OutDir)*.so" />
            <ContentWithTargetPath Include="@(Libs->'%(FullPath)')" RelativePath="%(Libs.Identity)" TargetPath="%(Libs.Filename)%(Libs.Extension)" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>
</Project>
