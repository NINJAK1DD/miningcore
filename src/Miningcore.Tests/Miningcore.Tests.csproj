<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsWindows Condition="'$(OS)' == 'Windows_NT'">true</IsWindows>
  </PropertyGroup>

  <PropertyGroup>
    <IsOSX Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</IsOSX>
    <IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU</Platforms>
    <AssemblyName>Miningcore.Tests</AssemblyName>
    <RootNamespace>Miningcore.Tests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="JsonRpc\**" />
    <EmbeddedResource Remove="JsonRpc\**" />
    <None Remove="JsonRpc\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.4" />
    <PackageReference Include="BenchmarkDotNet.Annotations" Version="0.13.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Microsoft.Reactive.Testing" Version="5.0.0" />
    <PackageReference Include="NLog" Version="5.4.0" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="NSubstitute" Version="4.4.0" />
    <!-- ConfigurationContractTests requires the public
         XunitException(message, innerException) constructor added in xUnit 2.4.2. -->
    <!-- When upgrading xUnit or its runner, verify cross-collection DisableParallelization
         scheduling: PostgresConfigurationLoggingTests relies on it while temporarily
         changing Program.logger and JsonConvert.DefaultSettings. Also verify the
         EqualException Expected: 1 / Actual: 0 and ThrowsException missing-range-exception
         message assertions in DefaultFloatingPointScopeTests.NumericFixtures_SurviveSupportedContaminationAndRestoreState. -->
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Miningcore\Miningcore.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
    <Reference Include="ZeroMQ">
      <HintPath>..\..\libs\ZeroMQ.dll</HintPath>
    </Reference>
    <ProjectReference Include="..\Miningcore.Tests.ProcessHost\Miningcore.Tests.ProcessHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures/Beam/gpu-beamhash3.json" />
    <None Include="../../README.md" Link="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../config.example.json" Link="config.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../examples/*.json"
          Link="examples/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="../../examples/README.md" Link="examples/README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../docs/releases.md" Link="docs/releases.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../docs/pps-arithmetic-migration.md" Link="docs/pps-arithmetic-migration.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../Miningcore/Persistence/Postgres/Scripts/*.sql"
          Link="Fixtures/Postgres/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../scripts/ops/*.sql" Link="Fixtures/Ops/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="test.runsettings">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures/Rpc/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures/config-diagnostics-v2.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Do not let a previous source-built runtime mask the explicit managed-only opt-out. -->
  <ItemGroup>
    <None Include="../../scripts/release/audit-settlement-shares.sql" Link="Fixtures/audit-settlement-shares.sql"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RemoveOdoCryptFromManagedOnlyTestOutput" BeforeTargets="PrepareForBuild"
          Condition="'$(IsWindows)' == 'true' and '$(BuildOdoCryptWindows)' == 'false'">
    <Delete Files="$(TargetDir)libodocrypt.dll" />
  </Target>

  <PropertyGroup>
    <FloatingPointTestHelperHostRid>$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</FloatingPointTestHelperHostRid>
  </PropertyGroup>

  <!-- Test-only capability/stack probe; managed-only listener smoke needs no C compiler. -->
  <Target Name="TrackFloatingPointTestHelperOutputs" BeforeTargets="BuildFloatingPointTestHelper;_CleanGetCurrentAndPriorFileWrites;CoreClean">
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)native-fenv/libminingcore_test_fenv.so;$(TargetDir)libminingcore_test_fenv.so" />
      <!-- Also clean helpers built directly, before a full build records FileWrites. -->
      <Clean Include="$(IntermediateOutputPath)native-fenv/libminingcore_test_fenv.so;$(TargetDir)libminingcore_test_fenv.so" />
    </ItemGroup>
  </Target>

  <Target Name="BuildFloatingPointTestHelper" AfterTargets="Build"
          Condition="'$(IsLinux)' == 'true' and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64' and !$(FloatingPointTestHelperHostRid.Contains('musl')) and '$(MiningcoreStratumListenerSmoke)' != 'true'"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildProjectDirectory)/Fixtures/FloatingPointProbe.c"
          Outputs="$(TargetDir)libminingcore_test_fenv.so">
    <MakeDir Directories="$(IntermediateOutputPath)native-fenv" />
    <!-- CC is one executable/wrapper path; use a wrapper for compiler arguments. -->
    <Exec Command="&quot;${CC:-cc}&quot; -std=c11 -O2 -fPIC -shared -fno-fast-math -Wall -Wextra -Werror &quot;$(MSBuildProjectDirectory)/Fixtures/FloatingPointProbe.c&quot; -o &quot;$(IntermediateOutputPath)native-fenv/libminingcore_test_fenv.so&quot;" />
    <Copy SourceFiles="$(IntermediateOutputPath)native-fenv/libminingcore_test_fenv.so" DestinationFolder="$(TargetDir)" />
  </Target>

  <!-- Copy Linux native libs from Miningcore output into test output -->
  <Target Name="CopyLibsLinux" AfterTargets="Build" Condition="'$(IsLinux)' == 'true'">
    <ItemGroup>
      <Libs Include="$(MSBuildProjectDirectory)/../Miningcore/bin/$(Configuration)/$(TargetFramework)/*.so" />
    </ItemGroup>

    <Message Importance="high"
             Text="Copying Linux native libs from Miningcore output to test output: @(Libs)"
             Condition="'@(Libs)' != ''" />

    <Copy SourceFiles="@(Libs)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="'@(Libs)' != ''" />
  </Target>
</Project>
