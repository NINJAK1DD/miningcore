{
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "miningcore.log",
        "apiLogFile": "miningcore-api.log",
        "logBaseDirectory": "logs",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": true
    },
    "notifications": {
        "enabled": false,
        "email": {
            "host": "smtp.example.com",
            "port": 587,
            "user": "CHANGE_ME_SMTP_USER",
            "password": "CHANGE_ME_SMTP_PASSWORD",
            "fromAddress": "info@yourpool.org",
            "fromName": "Miningcore operator"
        },
        "admin": {
            "enabled": false,
            "emailAddress": "user@example.com",
            "notifyBlockFound": true
        }
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "CHANGE_ME_POSTGRES_PASSWORD",
            "database": "miningcore"
        }
    },
    "equihashMaxThreads": 4,
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "coinbaseString": "Miningcore"
    },
    "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
    "api": {
        "enabled": true,
        "listenAddress": "127.0.0.1",
        "port": 4000,
        "adminPort": 4001,
        "metricsPort": 4002,
        "adminIpWhitelist": [ "127.0.0.1" ],
        "metricsIpWhitelist": [ "127.0.0.1" ],
        "legacyNullValueHandling": false,
        "rateLimiting": {
            "disabled": false,
            "rules": [
                {
                    "endpoint": "*",
                    "period": "1s",
                    "limit": 20
                }
            ],
            "ipWhitelist": [ "127.0.0.1" ]
        }
    },
    "pools": [{
        "id": "zec1",
        "enabled": true,
        "coin": "zcash",
        "address": "CHANGE_ME_ZCASH_POOL_WALLET_ADDRESS",
        "z-address": "CHANGE_ME_ZCASH_SHIELDED_WALLET_ADDRESS",
        "rewardRecipients": [
            {
                "type": "op",
                "address": "t1TbjCnoNdGWnwEt9QqCZvHuG3MsWf4Bj66",
                "percentage": 1.5
            }
        ],
        "blockRefreshInterval": 500,
        "jobRebroadcastTimeout": 10,
        "clientConnectionTimeout": 600,
        "banning": {
            "enabled": true,
            "time": 600,
            "invalidPercent": 50,
            "checkThreshold": 50
        },
        "ports": {
            "3092": {
                "difficulty": 0.1,
                "varDiff": {
                    "minDiff": 0.01,
                    "maxDiff": null,
                    "targetTime": 15,
                    "retargetTime": 90,
                    "variancePercent": 30,
                    "maxDelta": 1
                }
            },
            "3093": {
                "difficulty": 1
            }
        },
        "daemons": [
            {
                "host": "127.0.0.1",
                "port": 8232,
                "user": "CHANGE_ME_DAEMON_RPC_USER",
                "password": "CHANGE_ME_DAEMON_RPC_PASSWORD"
            }
        ],
        "paymentProcessing": {
            "enabled": true,
            "minimumPayment": 0.01,
            "payoutScheme": "PPLNS",
            "payoutSchemeConfig": {
                "factor": 2.0
            }
        }
    }]
}
