{
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "miningcore.log",
        "apiLogFile": "miningcore-api.log",
        "logBaseDirectory": "logs",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": true,
        "banOnLoginFailure": true
    },
    "notifications": {
        "enabled": false,
        "email": {
            "host": "smtp.example.com",
            "port": 587,
            "user": "CHANGE_ME_SMTP_USER",
            "password": "CHANGE_ME_SMTP_PASSWORD",
            "fromAddress": "pool@example.com",
            "fromName": "Miningcore operator"
        },
        "admin": {
            "enabled": false,
            "emailAddress": "user@example.com",
            "notifyBlockFound": true
        }
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "CHANGE_ME_POSTGRES_PASSWORD",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "coinbaseString": "Miningcore"
    },
    "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
    "api": {
        "enabled": true,
        "listenAddress": "127.0.0.1",
        "port": 4000,
        "adminPort": 4001,
        "metricsPort": 4002,
        "adminIpWhitelist": [ "127.0.0.1" ],
        "metricsIpWhitelist": [ "127.0.0.1" ],
        "legacyNullValueHandling": false,
        "rateLimiting": {
            "disabled": true
        }
    },
    "pools": [{
        "id": "hns1",
        "enabled": true,
        "coin": "handshake",
        "address": "CHANGE_ME_HANDSHAKE_POOL_WALLET_ADDRESS",
        "pubKey": "CHANGE_ME_HANDSHAKE_POOL_PUBLIC_KEY",
        "rewardRecipients": [
            {
                "type": "op",
                "address": "CHANGE_ME_HANDSHAKE_OPTIONAL_REWARD_RECIPIENT_ADDRESS",
                "percentage": 0
            }
        ],
        "enableAsicBoost": true,
        "blockRefreshInterval": 250,
        "jobRebroadcastTimeout": 0,
        "clientConnectionTimeout": 600,
        "maxActiveJobs": 1,
        "banning": {
            "enabled": true,
            "time": 600,
            "invalidPercent": 50,
            "checkThreshold": 50
        },
        "ports": {
            "3094": {
                "listenAddress": "0.0.0.0",
                "difficulty": 4
            },
            "3095": {
                "listenAddress": "0.0.0.0",
                "difficulty": 256
            }
        },
        "daemons": [
            {
                "host": "127.0.0.1",
                "port": 12037,
                "user": null,
                "password": null
            },
            {
                "host": "127.0.0.1",
                "port": 12039,
                "user": null,
                "password": null,
                "category": "wallet"
            }
        ],
        "paymentProcessing": {
            "enabled": true,
            "walletAccount": "CHANGE_ME_HANDSHAKE_WALLET_ACCOUNT",
            "minimumPayment": 1,
            "payoutScheme": "PPLNS",
            "payoutSchemeConfig": {
                "factor": 0.5
            }
        }
    }]
}
