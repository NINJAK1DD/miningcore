{
    // Starter configuration: replace every CHANGE_ME value and review it before use.
    // See README.md and ../config.example.json for topology and field guidance.
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "miningcore.log",
        "apiLogFile": "miningcore-api.log",
        "logBaseDirectory": "logs",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": true,
        "banOnLoginFailure": true
    },
    "notifications": {
        "enabled": false,
        "email": {
            "host": "smtp.example.com",
            "port": 587,
            "user": "CHANGE_ME_SMTP_USER",
            "password": "CHANGE_ME_SMTP_PASSWORD",
            "fromAddress": "pool@example.com",
            "fromName": "Miningcore operator"
        },
        "admin": {
            "enabled": false,
            "emailAddress": "user@example.com",
            "notifyBlockFound": true
        }
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "CHANGE_ME_POSTGRES_PASSWORD",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "coinbaseString": "Miningcore"
    },
    "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
    "api": {
        "enabled": true,
        "listenAddress": "127.0.0.1",
        "port": 4000,
        "adminPort": 4001,
        "metricsPort": 4002,
        "adminIpWhitelist": [ "127.0.0.1" ],
        "metricsIpWhitelist": [ "127.0.0.1" ],
        "legacyNullValueHandling": false,
        "rateLimiting": {
            "disabled": true
        }
    },
    "pools": [{
        "id": "beam1",
        "enabled": true,
        "coin": "beam",
        "maxActiveJobs": 4,
        "address": "CHANGE_ME_BEAM_POOL_WALLET_ADDRESS",
        "rewardRecipients": [
            {
                "type": "op",
                "address": "CHANGE_ME_BEAM_OPTIONAL_REWARD_RECIPIENT_ADDRESS",
                "percentage": 0
            }
        ],
        "clientConnectionTimeout": 600,
        "banning": {
            "enabled": true,
            "time": 600,
            "invalidPercent": 50,
            "checkThreshold": 50
        },
        "ports": {
            "3092": {
                "listenAddress": "0.0.0.0",
                "difficulty": 200,
                "varDiff": {
                    "minDiff": 200,
                    "maxDiff": null,
                    "targetTime": 15,
                    "retargetTime": 90,
                    "variancePercent": 30,
                    "maxDelta": 500
                }
            },
            "3093": {
                "listenAddress": "0.0.0.0",
                "difficulty": 700,
                "tls": false,
                // To enable TLS, add tlsPfxFile and tlsPfxPassword with a readable PFX.
                "varDiff": {
                    "minDiff": 200,
                    "maxDiff": null,
                    "targetTime": 15,
                    "retargetTime": 90,
                    "variancePercent": 30,
                    "maxDelta": 500
                }
            }
        },
        "daemons": [
            {
                "host": "127.0.0.1",
                // Must match beam-node's configured stratum_port.
                "port": 10005,
                "user": null,
                "password": null,
                "apiKey": "CHANGE_ME_BEAM_NODE_API_KEY"
            },
            {
                "host": "127.0.0.1",
                "port": 10000,
                "user": null,
                "password": null,
                "category": "wallet"
            },
            {
                "host": "127.0.0.1",
                "port": 10002,
                "user": null,
                "password": null,
                "category": "explorer"
            }
        ],
        "paymentProcessing": {
            "enabled": true,
            "minimumPayment": 1,
            "payoutScheme": "PPLNS",
            "payoutSchemeConfig": {
                "factor": 0.5
            }
        }
    }]
}
