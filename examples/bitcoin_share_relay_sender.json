{
  // Starter configuration: replace every CHANGE_ME value and review it before use.
  // See README.md and ../config.example.json for topology and field guidance.
  // Edge Stratum node A. It relays ordinary shares and does not own payouts or PostgreSQL.
  "clusterName": "bitcoin-relay-sender-a",
  "instanceId": 11,
  "logging": {
    "level": "info",
    "enableConsoleLog": true,
    "enableConsoleColors": true,
    "logFile": "miningcore.log"
  },
  "banning": {
    "manager": "Integrated",
    "banOnJunkReceive": true,
    "banOnInvalidShares": true,
    "banOnLoginFailure": true
  },
  "api": {
    "enabled": true,
    "listenAddress": "127.0.0.1",
    "port": 4000,
    "adminPort": 4001,
    "metricsPort": 4002,
    "adminIpWhitelist": [ "127.0.0.1" ],
    "metricsIpWhitelist": [ "127.0.0.1" ],
    "legacyNullValueHandling": false,
    "rateLimiting": {
      "disabled": true
    }
  },
  "paymentProcessing": {
    "enabled": false,
    "interval": 600
  },
  "shareRelay": {
    // Documentation-only address. Replace with an assigned private address on this sender.
    "publishUrl": "tcp://192.0.2.20:5555",
    // false makes this sender bind. The receiver connects to it.
    "connect": false,
    "sharedEncryptionKey": "CHANGE_ME_RELAY_A_SHARED_SECRET"
  },
  "pools": [
    {
      // Must exactly match the receiver's stable pool ID.
      "id": "bitcoin-solo",
      "enabled": true,
      "coin": "bitcoin",
      "address": "CHANGE_ME_BITCOIN_POOL_WALLET_ADDRESS",
      // Keep this identical to the recorder's payout-owner configuration.
      "rewardRecipients": [
        {
          "address": "bc1q94x9ncw62g09c80yr38jkewyn6cre3h473g54j",
          "percentage": 0
        }
      ],
      "enableInternalStratum": true,
      "blockRefreshInterval": 1000,
      "jobRebroadcastTimeout": 10,
      "clientConnectionTimeout": 600,
      "vardiffIdleSweepInterval": 30,
      "ports": {
        "3032": {
          "name": "BTC-EDGE-LOW-DIFF",
          "listenAddress": "*",
          "difficulty": 8192,
          "varDiff": {
            "minDiff": 4096,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        },
        "3033": {
          "name": "BTC-EDGE-HIGH-DIFF",
          "listenAddress": "*",
          "difficulty": 1048576,
          "varDiff": {
            "minDiff": 524288,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        }
      },
        "daemons": [
          {
            "host": "127.0.0.1",
            "port": 8332,
            "user": "CHANGE_ME_BITCOIN_RPC_USER",
            "password": "CHANGE_ME_BITCOIN_RPC_PASSWORD"
          }
        ],
        "banning": {
          "enabled": true,
          "checkThreshold": 50,
          "invalidPercent": 50,
          "time": 600
        },
        "paymentProcessing": {
        "enabled": false,
        "minimumPayment": 0.001,
        "payoutScheme": "SOLO"
      }
    }
  ]
}
