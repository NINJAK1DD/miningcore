{
  // Starter configuration: replace every CHANGE_ME value and review it before use.
  // See README.md and ../config.example.json for topology and field guidance.
  // Two independent SHA-256 SOLO pools. Bitcoin and Bitcoin Cash are not merged here.
  "clusterName": "bitcoin-bitcoin-cash-example",
  "logging": {
    "level": "info",
    "enableConsoleLog": true,
    "enableConsoleColors": true,
    "logFile": "miningcore.log",
    "perPoolLogFile": true
  },
  "banning": {
    "manager": "Integrated",
    "banOnJunkReceive": true,
    "banOnInvalidShares": true,
    "banOnLoginFailure": true
  },
  "api": {
    "enabled": true,
    "listenAddress": "127.0.0.1",
    "port": 4000,
    "adminPort": 4001,
    "metricsPort": 4002,
    "adminIpWhitelist": [ "127.0.0.1" ],
    "metricsIpWhitelist": [ "127.0.0.1" ],
    "legacyNullValueHandling": false,
    "rateLimiting": {
      "disabled": true
    }
  },
  "persistence": {
    "postgres": {
      "host": "127.0.0.1",
      "port": 5432,
      "user": "miningcore",
      "password": "CHANGE_ME_POSTGRES_PASSWORD",
      "database": "miningcore"
    }
  },
  "paymentProcessing": {
    "enabled": true,
    "interval": 600,
    "coinbaseString": "Miningcore"
  },
  "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
  "pools": [
    {
      "id": "bitcoin-solo",
      "enabled": true,
      "coin": "bitcoin",
      "address": "CHANGE_ME_BITCOIN_POOL_WALLET_ADDRESS",
      "rewardRecipients": [
        {
          "address": "bc1q94x9ncw62g09c80yr38jkewyn6cre3h473g54j",
          "percentage": 0
        }
      ],
      "enableInternalStratum": true,
      "blockRefreshInterval": 1000,
      "jobRebroadcastTimeout": 10,
      "clientConnectionTimeout": 600,
      "vardiffIdleSweepInterval": 30,
      "ports": {
        "3032": {
          "name": "BTC-LOW-DIFF",
          "listenAddress": "*",
          "difficulty": 8192,
          "varDiff": {
            "minDiff": 4096,
            "maxDiff": null,
            "maxDelta": null,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        },
        "3033": {
          "name": "BTC-HIGH-DIFF",
          "listenAddress": "*",
          "difficulty": 1048576,
          "varDiff": {
            "minDiff": 524288,
            "maxDiff": null,
            "maxDelta": null,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        }
      },
      "daemons": [
        {
          "host": "127.0.0.1",
          "port": 8332,
          "user": "CHANGE_ME_BITCOIN_RPC_USER",
          "password": "CHANGE_ME_BITCOIN_RPC_PASSWORD"
        }
      ],
      "banning": {
        "enabled": true,
        "checkThreshold": 50,
        "invalidPercent": 50,
        "time": 600
      },
      "paymentProcessing": {
        "enabled": true,
        "minimumPayment": 0.001,
        "payoutScheme": "SOLO"
      }
    },
    {
      "id": "bitcoin-cash-solo",
      "enabled": true,
      "coin": "bitcoin-cash",
      "addressType": "BCash",
      "address": "CHANGE_ME_BITCOIN_CASH_POOL_WALLET_CASHADDR",
      "rewardRecipients": [
        {
          "address": "bitcoincash:qzyvaurh8vlj22jvyhpdce6ld4lt3zfc3svyt665de",
          "percentage": 0
        }
      ],
      "enableInternalStratum": true,
      "blockRefreshInterval": 1000,
      "jobRebroadcastTimeout": 10,
      "clientConnectionTimeout": 600,
      "vardiffIdleSweepInterval": 30,
      "ports": {
        "3052": {
          "name": "BCH-LOW-DIFF",
          "listenAddress": "*",
          "difficulty": 8192,
          "varDiff": {
            "minDiff": 4096,
            "maxDiff": null,
            "maxDelta": null,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        },
        "3053": {
          "name": "BCH-HIGH-DIFF",
          "listenAddress": "*",
          "difficulty": 1048576,
          "varDiff": {
            "minDiff": 524288,
            "maxDiff": null,
            "maxDelta": null,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        }
      },
      "daemons": [
        {
          "host": "127.0.0.1",
          // For this same-host topology, set all three lines in the BCH node's
          // separate bitcoin.conf:
          // rpcport=8432
          // port=8433
          // listenonion=0
          // The last setting prevents either node from competing for the conventional
          // 127.0.0.1:8334 automatic-onion listener. Configure a separate, reviewed
          // BCH onion bind instead if inbound Tor service is required.
          "port": 8432,
          "user": "CHANGE_ME_BITCOIN_CASH_RPC_USER",
          "password": "CHANGE_ME_BITCOIN_CASH_RPC_PASSWORD"
        }
      ],
      "banning": {
        "enabled": true,
        "checkThreshold": 50,
        "invalidPercent": 50,
        "time": 600
      },
      "paymentProcessing": {
        "enabled": true,
        "minimumPayment": 0.01,
        "payoutScheme": "SOLO"
      }
    }
  ]
}
