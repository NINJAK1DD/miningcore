{
    // Starter configuration: replace every CHANGE_ME value and review it before use.
    // See README.md and ../config.example.json for topology and field guidance.
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "miningcore.log",
        "apiLogFile": "miningcore-api.log",
        "logBaseDirectory": "logs",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": true,
        "banOnLoginFailure": true
    },
    "notifications": {
        "enabled": false,
        "email": {
            "host": "smtp.example.com",
            "port": 587,
            "user": "CHANGE_ME_SMTP_USER",
            "password": "CHANGE_ME_SMTP_PASSWORD",
            "fromAddress": "pool@example.com",
            "fromName": "Miningcore operator"
        },
        "admin": {
            "enabled": false,
            "emailAddress": "user@example.com",
            "notifyBlockFound": true
        }
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "CHANGE_ME_POSTGRES_PASSWORD",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "coinbaseString": "Miningcore"
    },
    "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
    "api": {
        "enabled": true,
        "listenAddress": "127.0.0.1",
        "port": 4000,
        "adminPort": 4001,
        "metricsPort": 4002,
        "adminIpWhitelist": [ "127.0.0.1" ],
        "metricsIpWhitelist": [ "127.0.0.1" ],
        "legacyNullValueHandling": false,
        "rateLimiting": {
            "disabled": true
        }
    },
    "pools": [{
        "id": "xel1",
        "enabled": true,
        "coin": "xelis",
        "address": "CHANGE_ME_XELIS_POOL_WALLET_ADDRESS",
        "rewardRecipients": [
          {
            "type": "op",
            "address": "xel:gt8m2j4al22k8ecp99uducy84vnhn2nlx6ftxjgw2rfr0hg5n47sqkec7n4",
            "percentage": 0
          }
        ],
        "blockRefreshInterval": 250,
        "jobRebroadcastTimeout": 0,
        "clientConnectionTimeout": 600,
        "banning": {
          "enabled": true,
          "time": 600,
          "invalidPercent": 50,
          "checkThreshold": 50
        },
        "ports": {
          "4073": {
            "name": "GPU-SMALL",
            "listenAddress": "*",
            "difficulty": 1024000,
            "varDiff": {
              "minDiff": 512000,
              "maxDiff": null,
              "targetTime": 15,
              "retargetTime": 90,
              "variancePercent": 100,
              "maxDelta": 512
            }
          }
        },
        "daemons": [
            {
              "host": "127.0.0.1",
              "port": 8080,
              "user": null,
              "password": null
            },
            {
                "host": "127.0.0.1",
                "port": 8081,
                "user": "CHANGE_ME_WALLET_RPC_USER",
                "password": "CHANGE_ME_WALLET_RPC_PASSWORD",
                "category": "wallet"
            }
        ],
        "paymentProcessing": {
            "enabled": true,
            "minimumPayment": 1,
            "payoutScheme": "PPLNS",
            "payoutSchemeConfig": {
                "factor": 0.5
            }
        }
    }]
}
