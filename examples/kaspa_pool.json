{
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "miningcore.log",
        "apiLogFile": "miningcore-api.log",
        "logBaseDirectory": "logs",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": true
    },
    "notifications": {
        "enabled": false,
        "email": {
            "host": "smtp.example.com",
            "port": 587,
            "user": "CHANGE_ME_SMTP_USER",
            "password": "CHANGE_ME_SMTP_PASSWORD",
            "fromAddress": "info@yourpool.org",
            "fromName": "Miningcore operator"
        },
        "admin": {
            "enabled": false,
            "emailAddress": "user@example.com",
            "notifyBlockFound": true
        }
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "CHANGE_ME_POSTGRES_PASSWORD",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "coinbaseString": "Miningcore"
    },
    "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
    "api": {
        "enabled": true,
        "listenAddress": "127.0.0.1",
        "port": 4000,
        "adminPort": 4001,
        "metricsPort": 4002,
        "adminIpWhitelist": [ "127.0.0.1" ],
        "metricsIpWhitelist": [ "127.0.0.1" ],
        "legacyNullValueHandling": false,
        "rateLimiting": {
            "disabled": false,
            "rules": [
                {
                    "endpoint": "*",
                    "period": "1s",
                    "limit": 20
                }
            ],
            "ipWhitelist": [ "127.0.0.1" ]
        }
    },
    "pools": [{
        "id": "kas1",
        "enabled": true,
        "coin": "kaspa",
        "address": "CHANGE_ME_KASPA_POOL_WALLET_ADDRESS",
        "rewardRecipients": [
            {
                "type": "op",
                "address": "kaspa:qzdtdjatlzecrt9u4v22p5vgud6w6ylvemly9df6zpu0gp0yks9xxp24q79pu",
                "percentage": 1
            }
        ],
        "protobufWalletRpcServiceName": "kaspawalletd.kaspawalletd",
        "enableAsicBoost": true,
        "clientConnectionTimeout": 600,
        "banning": {
            "enabled": true,
            "time": 600,
            "invalidPercent": 50,
            "checkThreshold": 50
        },
        "ports": {
            "3094": {
                "listenAddress": "0.0.0.0",
                "difficulty": 4,
                "varDiff": {
                    "minDiff": 2,
                    "maxDiff": null,
                    "targetTime": 15,
                    "retargetTime": 90,
                    "variancePercent": 100,
                    "maxDelta": 512
                }
            },
            "3095": {
                "listenAddress": "0.0.0.0",
                "difficulty": 4,
                "tls": false,
                // To enable TLS, add tlsPfxFile and tlsPfxPassword with a readable PFX.
                "varDiff": {
                    "minDiff": 2,
                    "maxDiff": null,
                    "targetTime": 15,
                    "retargetTime": 90,
                    "variancePercent": 100,
                    "maxDelta": 512
                }
            }
        },
        "daemons": [
            {
                "host": "127.0.0.1",
                "port": 16110,
                "user": null,
                "password": null
            },
            {
                "host": "127.0.0.1",
                "port": 8082,
                "user": null,
                "password": null,
                "category": "wallet"
            }
        ],
        "paymentProcessing": {
            "enabled": true,
            "walletPassword": "CHANGE_ME_KASPA_WALLET_PASSWORD",
            "minimumPayment": 1,
            "versionEnablingMaxFee": "v0.12.18-rc5",
            "maxFee": 200000,
            "payoutScheme": "PPLNS",
            "payoutSchemeConfig": {
                "factor": 0.5
            }
        }
    }]
}
