{
    // Starter configuration: replace every CHANGE_ME value and review it before use.
    // See README.md and ../config.example.json for topology and field guidance.
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "miningcore.log",
        "apiLogFile": "miningcore-api.log",
        "logBaseDirectory": "logs",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": true,
        "banOnLoginFailure": true
    },
    "notifications": {
        "enabled": false,
        "email": {
            "host": "smtp.example.com",
            "port": 587,
            "user": "CHANGE_ME_SMTP_USER",
            "password": "CHANGE_ME_SMTP_PASSWORD",
            "fromAddress": "pool@example.com",
            "fromName": "Miningcore operator"
        },
        "admin": {
            "enabled": false,
            "emailAddress": "user@example.com",
            "notifyBlockFound": true
        }
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "CHANGE_ME_POSTGRES_PASSWORD",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "coinbaseString": "Miningcore"
    },
    "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
    "api": {
        "enabled": true,
        "listenAddress": "127.0.0.1",
        "port": 4000,
        "adminPort": 4001,
        "metricsPort": 4002,
        "adminIpWhitelist": [ "127.0.0.1" ],
        "metricsIpWhitelist": [ "127.0.0.1" ],
        "legacyNullValueHandling": false,
        "rateLimiting": {
            "disabled": true
        }
    },
    "pools": [{
      "id": "xmr1",
      "enabled": true,
      "coin": "monero",
      "randomXRealm": "xmr1",
      "address": "CHANGE_ME_MONERO_POOL_WALLET_ADDRESS",
      "rewardRecipients": [
        {
          "address": "43iiCs5pjvqbzYDvGSPgwtTdR4E4s996cSBsCSTe5HHbSrzr4HBosKZch8t7Fpg34DL9dNcN22T7H6JWEC23B9iDLAZqQsp",
          "percentage": 0
        }
      ],
      "enableInternalStratum": true,
      "blockRefreshInterval": 500,
      "jobRebroadcastTimeout": 0,
      "clientConnectionTimeout": 600,
      "vardiffIdleSweepInterval": 30,
      "banning": {
        "enabled": true,
        "time": 600,
        "invalidPercent": 50,
        "checkThreshold": 50
      },
      "ports": {
        "3032": {
          "listenAddress": "*",
          "difficulty": 7500,
          "name": "XMR-LOW-DIFF",
          "varDiff": {
            "minDiff": 1000,
            "maxDiff": null,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        },
        "3033": {
          "listenAddress": "*",
          "difficulty": 25000,
          "name": "XMR-MEDIUM-DIFF",
          "varDiff": {
            "minDiff": 10000,
            "maxDiff": null,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        },
        "3034": {
          "listenAddress": "*",
          "difficulty": 200000,
          "name": "XMR-HIGH-DIFF",
          "varDiff": {
            "minDiff": 200000,
            "maxDiff": null,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        }
      },
      "daemons": [
        {
          "host": "127.0.0.1",
          "port": 18081,
          "user": "CHANGE_ME_DAEMON_RPC_USER",
          "password": "CHANGE_ME_DAEMON_RPC_PASSWORD"
       },
        {
          "host": "127.0.0.1",
          "port": 18082,
