{
    // Starter configuration: replace every CHANGE_ME value and review it before use.
    // See README.md and ../config.example.json for topology and field guidance.
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "miningcore.log",
        "apiLogFile": "miningcore-api.log",
        "logBaseDirectory": "logs",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": true,
        "banOnLoginFailure": true
    },
    "notifications": {
        "enabled": false,
        "email": {
            "host": "smtp.example.com",
            "port": 587,
            "user": "CHANGE_ME_SMTP_USER",
            "password": "CHANGE_ME_SMTP_PASSWORD",
            "fromAddress": "pool@example.com",
            "fromName": "Miningcore operator"
        },
        "admin": {
            "enabled": false,
            "emailAddress": "user@example.com",
            "notifyBlockFound": true
        }
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "CHANGE_ME_POSTGRES_PASSWORD",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "coinbaseString": "Miningcore"
    },
    "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
    "api": {
        "enabled": true,
        "listenAddress": "127.0.0.1",
        "port": 4000,
        "adminPort": 4001,
        "metricsPort": 4002,
        "adminIpWhitelist": [ "127.0.0.1" ],
        "metricsIpWhitelist": [ "127.0.0.1" ],
        "legacyNullValueHandling": false,
        "rateLimiting": {
            "disabled": true
        }
    },
    "pools": [{
        "id": "vrsc1",
        "enabled": true,
        "coin": "veruscoin",
        "address": "CHANGE_ME_VERUSCOIN_POOL_WALLET_ADDRESS",
        "GBTArgs": [{
            "capabilities": [
                "coinbasetxn", 
                "workid",
                "coinbase/append"
            ],
            "rules": [
                "segwit"
            ]
        }],
        "rewardRecipients": [
            {
                "type": "op",
                "address": "CHANGE_ME_VERUSCOIN_OPTIONAL_REWARD_RECIPIENT_ADDRESS",
                "percentage": 0
            }
        ],
        "blockRefreshInterval": 0,
        "jobRebroadcastTimeout": 0,
        "clientConnectionTimeout": 2400,
        "banning": {
            "enabled": true,
            "time": 600,
            "invalidPercent": 50,
            "checkThreshold": 50
        },
        "ports": {
            "3092": {
                "listenAddress": "0.0.0.0",
                "difficulty": 25600000,
                "varDiff": {
                    "minDiff": 25600000,
                    "maxDiff": null,
                    "targetTime": 15,
                    "retargetTime": 90,
                    "variancePercent": 30,
                    "maxDelta": 512
                }
            },
            "3093": {
                "listenAddress": "0.0.0.0",
                "difficulty": 25600000,
                "tls": false,
                // To enable TLS, add tlsPfxFile and tlsPfxPassword with a readable PFX.
                "varDiff": {
                    "minDiff": 25600000,
                    "maxDiff": null,
                    "targetTime": 15,
                    "retargetTime": 90,
                    "variancePercent": 30,
                    "maxDelta": 512
                }
            }
        },
        "daemons": [
            {
                "host": "127.0.0.1",
                "port": 7771,
                "user": "CHANGE_ME_DAEMON_RPC_USER",
                "password": "CHANGE_ME_DAEMON_RPC_PASSWORD",
                "zmqBlockNotifySocket": "tcp://127.0.0.1:7772",
                "zmqBlockNotifyTopic": "hashblock"
            }
        ],
        "paymentProcessing": {
            "enabled": true,
            "minimumPayment": 1,
            "payoutScheme": "PPLNS",
            "payoutSchemeConfig": {
                "factor": 0.5
            }
        }
    }]
}
