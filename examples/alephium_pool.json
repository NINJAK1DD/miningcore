{
    // Starter configuration: replace every CHANGE_ME value and review it before use.
    // See README.md and ../config.example.json for topology and field guidance.
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "miningcore.log",
        "apiLogFile": "miningcore-api.log",
        "logBaseDirectory": "logs",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": true,
        "banOnLoginFailure": true
    },
    "notifications": {
        "enabled": false,
        "email": {
            "host": "smtp.example.com",
            "port": 587,
            "user": "CHANGE_ME_SMTP_USER",
            "password": "CHANGE_ME_SMTP_PASSWORD",
            "fromAddress": "pool@example.com",
            "fromName": "Miningcore operator"
        },
        "admin": {
            "enabled": false,
            "emailAddress": "user@example.com",
            "notifyBlockFound": true
        }
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "CHANGE_ME_POSTGRES_PASSWORD",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "coinbaseString": "Miningcore"
    },
    "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
    "api": {
        "enabled": true,
        "listenAddress": "127.0.0.1",
        "port": 4000,
        "adminPort": 4001,
        "metricsPort": 4002,
        "adminIpWhitelist": [ "127.0.0.1" ],
        "metricsIpWhitelist": [ "127.0.0.1" ],
        "legacyNullValueHandling": false,
        "rateLimiting": {
            "disabled": true
        }
    },
    "pools": [{
        "id": "alph1",
        "enabled": true,
        "coin": "alephium",
        "address": "CHANGE_ME_ALEPHIUM_POOL_WALLET_ADDRESS",
        "rewardRecipients": [
            {
                "type": "op",
                "address": "CHANGE_ME_ALEPHIUM_OPTIONAL_REWARD_RECIPIENT_ADDRESS",
                "percentage": 0
            }
        ],
        "enableAsicBoost": true,
        "enableInternalStratum": true,
        "blockRefreshInterval": 0,
        "jobRebroadcastTimeout": 0,
        "clientConnectionTimeout": 600,
        "vardiffIdleSweepInterval": 30,
        "socketJobMessageBufferSize": 16384,
        "banning": {
            "enabled": true,
            "time": 600,
            "invalidPercent": 50,
            "checkThreshold": 50
        },
        "ports": {
            "3094": {
                "name": "ALPH-LOW-DIFF",
                "listenAddress": "*",
                "difficulty": 4,
                "varDiff": {
                    "minDiff": 2,
                    "maxDiff": null,
                    "targetTime": 15,
                    "retargetTime": 90,
                    "variancePercent": 30,
                    "maxDelta": 4
                }
            },
            "3095": {
                "name": "ALPH-LOW-DIFF-TLS-OPTION",
                "listenAddress": "*",
                "difficulty": 4,
                "tls": false,
                // To enable TLS, add tlsPfxFile and tlsPfxPassword with a readable PFX.
                "varDiff": {
                    "minDiff": 2,
                    "maxDiff": null,
                    "targetTime": 15,
                    "retargetTime": 90,
                    "variancePercent": 30,
                    "maxDelta": 4
                }
            },
            "3096": {
                "name": "ALPH-HIGH-DIFF",
                "listenAddress": "*",
                "difficulty": 256,
                "varDiff": {
                    "minDiff": 256,
                    "maxDiff": null,
                    "targetTime": 15,
                    "retargetTime": 90,
                    "variancePercent": 30,
                    "maxDelta": 256
                }
            }
        },
        "daemons": [
            {
                "host": "127.0.0.1",
                "port": 12973,
                "user": null,
                "password": null,
                "apiKey": "CHANGE_ME_ALEPHIUM_NODE_API_KEY",
                "minerApiPort": 10973
            }
        ],
        "paymentProcessing": {
            "enabled": true,
            "walletName": "CHANGE_ME_ALEPHIUM_WALLET_NAME",
            "walletPassword": "CHANGE_ME_ALEPHIUM_WALLET_PASSWORD",
            "minimumPayment": 1,
            "payoutScheme": "PPLNS",
            "payoutSchemeConfig": {
                "factor": 0.5
            }
        }
    }]
}
