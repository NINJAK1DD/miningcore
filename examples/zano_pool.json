{
    // Starter configuration: replace every CHANGE_ME value and review it before use.
    // See README.md and ../config.example.json for topology and field guidance.
    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "miningcore.log",
        "apiLogFile": "miningcore-api.log",
        "logBaseDirectory": "logs",
        "perPoolLogFile": false
    },
    "banning": {
        "manager": "Integrated",
        "banOnJunkReceive": true,
        "banOnInvalidShares": true,
        "banOnLoginFailure": true
    },
    "notifications": {
        "enabled": false,
        "email": {
            "host": "smtp.example.com",
            "port": 587,
            "user": "CHANGE_ME_SMTP_USER",
            "password": "CHANGE_ME_SMTP_PASSWORD",
            "fromAddress": "pool@example.com",
            "fromName": "Miningcore operator"
        },
        "admin": {
            "enabled": false,
            "emailAddress": "user@example.com",
            "notifyBlockFound": true
        }
    },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "CHANGE_ME_POSTGRES_PASSWORD",
            "database": "miningcore"
        }
    },
    "paymentProcessing": {
        "enabled": true,
        "interval": 600,
        "coinbaseString": "Miningcore"
    },
    "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
    "api": {
        "enabled": true,
        "listenAddress": "127.0.0.1",
        "port": 4000,
        "adminPort": 4001,
        "metricsPort": 4002,
        "adminIpWhitelist": [ "127.0.0.1" ],
        "metricsIpWhitelist": [ "127.0.0.1" ],
        "legacyNullValueHandling": false,
        "rateLimiting": {
            "disabled": true
        }
    },
    "pools": [
        {
            "id": "zano1",
            "enabled": true,
            "coin": "zano",
            "address": "CHANGE_ME_ZANO_POOL_WALLET_ADDRESS",
            "rewardRecipients": [
                {
                    "type": "op",
                    "address": "CHANGE_ME_ZANO_OPTIONAL_REWARD_RECIPIENT_ADDRESS",
                    "percentage": 0
                }
            ],
            "enableInternalStratum": true,
            "blockRefreshInterval": 250,
            "jobRebroadcastTimeout": 3,
            "clientConnectionTimeout": 600,
            "vardiffIdleSweepInterval": 30,
            "banning": {
                "enabled": true,
                "time": 600,
                "invalidPercent": 50,
                "checkThreshold": 50
            },
            "ports": {
                "3364": {
                    "name": "ZANO-LOW-DIFF",
                    "listenAddress": "*",
                    "difficulty": 250000000,
                    "varDiff": {
                        "minDiff": 125000000,
                        "maxDiff": null,
                        "targetTime": 15,
                        "retargetTime": 90,
                        "variancePercent": 30,
                        "maxDelta": 250000000
                    }
                },
                "3365": {
                    "name": "ZANO-HIGH-DIFF",
                    "listenAddress": "*",
                    "difficulty": 4000000000,
                    "tls": false,
                    // To enable TLS, add tlsPfxFile and tlsPfxPassword with a readable PFX.
                    "varDiff": {
                        "minDiff": 2000000000,
                        "maxDiff": null,
                        "targetTime": 15,
                        "retargetTime": 90,
                        "variancePercent": 30,
                        "maxDelta": 4000000000
                    }
                }
            },
            "daemons": [
                {
                    "host": "127.0.0.1",
                    "port": 11211,
                    "user": null,
                    "password": null
                },
                {
                    "host": "127.0.0.1",
                    "port": 11212,
                    "user": null,
                    "password": null,
                    "category": "wallet"
                }
            ],
            "paymentProcessing": {
                "enabled": true,
                "minimumPayment": 0.1,
                "payoutScheme": "PPLNS",
                "payoutSchemeConfig": {
                    "factor": 0.5
                }
            }
        }
    ]
}
