{
  // Two independent SOLO pools in one process. Bitcoin and Dogecoin are not merge-mined together.
  "clusterName": "bitcoin-dogecoin-example",
  "logging": {
    "level": "info",
    "enableConsoleLog": true,
    "enableConsoleColors": true,
    "logFile": "miningcore.log",
    "perPoolLogFile": true
  },
  "api": {
    "enabled": true,
    "listenAddress": "127.0.0.1",
    "port": 4000,
    "adminPort": 4001,
    "metricsPort": 4002,
    "adminIpWhitelist": [ "127.0.0.1" ],
    "metricsIpWhitelist": [ "127.0.0.1" ],
    "legacyNullValueHandling": false,
    "rateLimiting": {
      "disabled": false,
      "ipWhitelist": [ "127.0.0.1" ],
      "rules": [
        {
          "endpoint": "*",
          "period": "1s",
          "limit": 20
        }
      ]
    }
  },
  "persistence": {
    "postgres": {
      "host": "127.0.0.1",
      "port": 5432,
      "user": "miningcore",
      "password": "CHANGE_ME_POSTGRES_PASSWORD",
      "database": "miningcore"
    }
  },
  "paymentProcessing": {
    "enabled": true,
    "interval": 600,
    "coinbaseString": "Miningcore"
  },
  "shareRecoveryFile": "/var/lib/miningcore/recovered-shares.txt",
  "pools": [
    {
      "id": "bitcoin-solo",
      "enabled": true,
      "coin": "bitcoin",
      "address": "CHANGE_ME_BITCOIN_POOL_WALLET_ADDRESS",
      "enableInternalStratum": true,
      "blockRefreshInterval": 1000,
      "jobRebroadcastTimeout": 10,
      "clientConnectionTimeout": 600,
      "ports": {
        "3032": {
          "name": "BTC-LOW-DIFF",
          "listenAddress": "*",
          "difficulty": 8192,
          "varDiff": {
            "minDiff": 4096,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        },
        "3033": {
          "name": "BTC-HIGH-DIFF",
          "listenAddress": "*",
          "difficulty": 1048576,
          "varDiff": {
            "minDiff": 524288,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        }
      },
      "daemons": [
        {
          "host": "127.0.0.1",
          "port": 8332,
          "user": "CHANGE_ME_BITCOIN_RPC_USER",
          "password": "CHANGE_ME_BITCOIN_RPC_PASSWORD"
        }
      ],
      "paymentProcessing": {
        "enabled": true,
        "minimumPayment": 0.001,
        "payoutScheme": "SOLO"
      }
    },
    {
      "id": "dogecoin-solo",
      "enabled": true,
      "coin": "dogecoin",
      "address": "CHANGE_ME_DOGECOIN_POOL_WALLET_ADDRESS",
      "enableInternalStratum": true,
      "blockRefreshInterval": 1000,
      "jobRebroadcastTimeout": 10,
      "clientConnectionTimeout": 600,
      "ports": {
        "3042": {
          "name": "DOGE-LOW-DIFF",
          "listenAddress": "*",
          "difficulty": 1024,
          "varDiff": {
            "minDiff": 512,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        },
        "3043": {
          "name": "DOGE-HIGH-DIFF",
          "listenAddress": "*",
          "difficulty": 65536,
          "varDiff": {
            "minDiff": 32768,
            "targetTime": 15,
            "retargetTime": 90,
            "variancePercent": 30
          }
        }
      },
      "daemons": [
        {
          "host": "127.0.0.1",
          "port": 22555,
          "user": "CHANGE_ME_DOGECOIN_RPC_USER",
          "password": "CHANGE_ME_DOGECOIN_RPC_PASSWORD"
        }
      ],
      "paymentProcessing": {
        "enabled": true,
        "minimumPayment": 1.0,
        "payoutScheme": "SOLO"
      }
    }
  ]
}
